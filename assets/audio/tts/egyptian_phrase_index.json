    },
    {
      "text": "تم اختيار العربية",
      "asset": "audio/tts/clips/099c38af71b66be4.mp3"
    },
    {
      "text": "تم الإلغاء",
      "asset": "audio/tts/clips/74450d7ad65a7b52.mp3"
    },
    {
      "text": "تمام، فتحت وضع الإعدادات",
      "asset": "audio/tts/clips/618e3b634b404ad6.mp3"
    },
    {
      "text": "تمام، فتحت وضع البحث عن الأشياء",
      "asset": "audio/tts/clips/f8575d3d692563d8.mp3"
    },
    {
      "text": "تمام، فتحت وضع التنقل",
      "asset": "audio/tts/clips/5c73c8381e3291f5.mp3"
    },
    {
      "text": "تمام، فتحت وضع الرئيسية",
      "asset": "audio/tts/clips/55be040953959156.mp3"
    },
    {
      "text": "تمام، فتحت وضع القراءة",
      "asset": "audio/tts/clips/7fa524aa90a2ed35.mp3"
    },
    {
      "text": "تمام، فتحت وضع في اليد",
      "asset": "audio/tts/clips/0b01a26b5a0cdce8.mp3"
    },
    {
      "text": "تمام، هدور على زجاجة",
      "asset": "audio/tts/clips/beac7f2762583267.mp3"
    },
    {
      "text": "تمام، هدور على شنطة",
      "asset": "audio/tts/clips/25515019ccbcb213.mp3"
    },
    {
      "text": "تمام، هدور على علامة خروج",
      "asset": "audio/tts/clips/e42726450200d541.mp3"
    },
    {
      "text": "تمام، هدور على كتاب",
      "asset": "audio/tts/clips/379f4e28cb9fcaf6.mp3"
    },
    {
      "text": "تمام، هدور على كرسي",
      "asset": "audio/tts/clips/fcb1bb51fdea5cf8.mp3"
    },
    {
      "text": "تمام، هدور على كوب",
      "asset": "audio/tts/clips/739beae8bd7f2aaf.mp3"
    },
    {
      "text": "تمام، هدور على محفظة",
      "asset": "audio/tts/clips/d50b1dc62de63fa7.mp3"
    },
    {
      "text": "تمام، هدور على مفاتيح",
      "asset": "audio/tts/clips/641e470d3c4ae720.mp3"
    },
    {
      "text": "تمام، هدور على موبايل",
      "asset": "audio/tts/clips/b07b359ad25ea218.mp3"
    },
    {
      "text": "تمام، هدور على ميكروويف",
      "asset": "audio/tts/clips/3b83a5564777df50.mp3"
    },
    {
      "text": "تمام، هدور على نظارة",
      "asset": "audio/tts/clips/964937c9787c7298.mp3"
    },
    {
      "text": "تنبيه، نظام كشف الخطر غير متاح حالياً، التنقل شغال.",
      "asset": "audio/tts/clips/619ef6e861641a83.mp3"
    },
    {
      "text": "جاري تنفيذ الأمر الصوتي",
      "asset": "audio/tts/clips/15356d003ba0740a.mp3"
    },
    {
      "text": "جارٍ الاتصال",
      "asset": "audio/tts/clips/1c0b2d3e5cf4ac5b.mp3"
    },
    {
      "text": "جارٍ الاتصال خلال...",
      "asset": "audio/tts/clips/6d61e214b61af6cb.mp3"
    },
    {
      "text": "جارٍ القراءة…",
      "asset": "audio/tts/clips/1a14d7d8f7a9eddc.mp3"
    },
    {
      "text": "جهات الطوارئ",
      "asset": "audio/tts/clips/09ca816b1e7620ca.mp3"
    },
    {
      "text": "جهة اتصال الطوارئ",
      "asset": "audio/tts/clips/b28f8adf94d0b213.mp3"
    },
    {
      "text": "حدث خطأ في الاستماع",
      "asset": "audio/tts/clips/c698c18afd09e33c.mp3"
    },
    {
      "text": "حفظ",
      "asset": "audio/tts/clips/56ee6e0d206b608b.mp3"
    },
    {
      "text": "حقيبة",
      "asset": "audio/tts/clips/7f8ce543ef04e6ec.mp3"
    },
    {
      "text": "خارجي",
      "asset": "audio/tts/clips/b720655dbc68e2f8.mp3"
    },
    {
      "text": "خطر شديد، في نار قريبة جداً. ابعد فوراً وخلي بالك.",
      "asset": "audio/tts/clips/3e2c3ea7fc076afd.mp3"
    },
    {
      "text": "خطر عالي، النار قريبة. ابعد فوراً وخلي بالك.",
      "asset": "audio/tts/clips/d075f85e6a16cfbf.mp3"
    },
    {
      "text": "خطر، في نار قريبة منك. ابعد فوراً وخلي بالك.",
      "asset": "audio/tts/clips/0a1402e26f127547.mp3"
    },
    {
      "text": "خلي بالك، في حذاء أو شبشب على الأرض وممكن يسبب انزلاق",
      "asset": "audio/tts/clips/d1ee13f5a233c3e7.mp3"
    },
    {
      "text": "خلي بالك، في علامة أرض مبلولة. امشي ببطء.",
      "asset": "audio/tts/clips/ed17fd4deadd45b0.mp3"
    },
    {
      "text": "داخلي",
      "asset": "audio/tts/clips/746faf35e0f68561.mp3"
    },
    {
      "text": "دور على حاجة",
      "asset": "audio/tts/clips/0f73ab0d66544b27.mp3"
    },
    {
      "text": "دورلي على حاجة",
      "asset": "audio/tts/clips/145a1875db1b4216.mp3"
    },
    {
      "text": "رجوع",
      "asset": "audio/tts/clips/328ddce5bbca254f.mp3"
    },
    {
      "text": "رقم الهاتف",
      "asset": "audio/tts/clips/211cce4ca4ef0c4d.mp3"
    },
    {
      "text": "ريموت",
      "asset": "audio/tts/clips/c1bb51ad3f269388.mp3"
    },
    {
      "text": "زجاجة",
      "asset": "audio/tts/clips/978718732b1e688d.mp3"
    },
    {
      "text": "ساعدني أمشي",
      "asset": "audio/tts/clips/e8483172e8ba78b2.mp3"
    },
    {
      "text": "ساعدني امشي",
      "asset": "audio/tts/clips/c7c19b3e2aa25152.mp3"
    },
    {
      "text": "ستسمع العدّ التنازلي: 3، 2، 1...",
      "asset": "audio/tts/clips/ed1567ae893e5242.mp3"
    },
    {
      "text": "سرعة الكلام",
      "asset": "audio/tts/clips/82444322f9f6c1c2.mp3"
    },
    {
      "text": "سريع",
      "asset": "audio/tts/clips/d624594696f53957.mp3"
    },
    {
      "text": "شخص",
      "asset": "audio/tts/clips/664f8f190d40970d.mp3"
    },
    {
      "text": "شنطة",
      "asset": "audio/tts/clips/19d91a118ddf5c49.mp3"
    },
    {
      "text": "طاولة",
      "asset": "audio/tts/clips/04df45911d7e95ec.mp3"
    },
    {
      "text": "عايز تدور على إيه؟",
      "asset": "audio/tts/clips/6050a69ee274a8f1.mp3"
    },
    {
      "text": "علامة الخروج قريبة منك.",
      "asset": "audio/tts/clips/5f967ea9e67b3a98.mp3"
    },
    {
      "text": "ـ",
      "asset": "audio/tts/clips/2dff29a666470832.mp3"
    },
    {
      "text": "فون",
      "asset": "audio/tts/clips/e898209b4e013a60.mp3"
    },
    {
      "text": "في اليد",
      "asset": "audio/tts/clips/e8fc9278eeaff4e3.mp3"
    },
    {
      "text": "قارئ العملة",
      "asset": "audio/tts/clips/b56bdf5df14a9976.mp3"
    },
    {
      "text": "قارئ المستندات",
      "asset": "audio/tts/clips/ed36dc437c118ad6.mp3"
    },
    {
      "text": "قدامك علامة توقف. وقف وخلي بالك من الطريق حواليك.",
      "asset": "audio/tts/clips/1531ef45f1fb8fda.mp3"
    },
    {
      "text": "قراءة النص",
      "asset": "audio/tts/clips/fe42bd9482812546.mp3"
    },
    {
      "text": "كاشف الأشياء مش متاح على الجهاز",
      "asset": "audio/tts/clips/252b05d317b684d2.mp3"
    },
    {
