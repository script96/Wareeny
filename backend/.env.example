# Where the Gemma vision model is served (Ollama by default).
OLLAMA_URL=http://localhost:11434
# A vision-capable Gemma tag pulled into Ollama (e.g. `ollama pull gemma3:4b`).
GEMMA_MODEL=gemma4:e4b
APP_ENV=dev
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_DATABASE=wareeny
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# Optional comma-separated Clerk token azp allowlist. Leave empty for native
# development until your Clerk instance supplies a stable authorized party.
CLERK_AUTHORIZED_PARTIES=
ALLOWED_ORIGINS=
