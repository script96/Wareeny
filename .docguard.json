{
  "$schema": "https://raccioly.github.io/docguard/schemas/docguard-config.schema.json",
  "projectName": "Wareeny",
  "version": "0.5",
  "profile": "standard",
  "projectType": "unknown",
  "projectTypeConfig": {
    "needsEnvVars": true,
    "needsEnvExample": true,
    "needsE2E": false,
    "needsDatabase": true
  },
  "requiredFiles": {
    "canonical": [
      "docs-canonical/ARCHITECTURE.md",
      "docs-canonical/DATA-MODEL.md",
      "docs-canonical/SECURITY.md",
      "docs-canonical/TEST-SPEC.md",
      "docs-canonical/ENVIRONMENT.md",
      "docs-canonical/REQUIREMENTS.md"
    ]
  },
  "validators": {
    "structure": true,
    "docsSync": true,
    "drift": true,
    "changelog": true,
    "architecture": false,
    "testSpec": true,
    "security": false,
    "environment": true,
    "freshness": true
  },
  "severity": {}
}
